# Salin menjadi deploy/.env di server. File .env tidak ikut di-commit.

# Nama domain server. Caddy mengambil sertifikat HTTPS untuk nama ini secara otomatis.
# ":80" = uji di laptop tanpa HTTPS (pakai juga HTTP_PORT=8080 bila port 80 terpakai).
SITE_ADDRESS=sigap-bencana.southeastasia.cloudapp.azure.com

# Kata sandi basis data. Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=
