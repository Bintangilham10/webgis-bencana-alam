# Salin menjadi deploy/.env di server. File .env tidak ikut di-commit.

# Nama domain server. Caddy mengambil sertifikat HTTPS untuk nama ini secara otomatis.
# ":80" = uji di laptop tanpa HTTPS (pakai juga HTTP_PORT=8080 bila port 80 terpakai).
SITE_ADDRESS=sigap-bencana.southeastasia.cloudapp.azure.com

# Kata sandi basis data. Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=

# Web Push (notifikasi tetap sampai walau tab SIGAP ditutup). Opsional: tanpa tiga baris
# ini push tidak aktif. Buat SEKALI di server dengan:
#   docker compose -f deploy/compose.yaml run --rm --no-deps api node scripts/kunci-push.js https://<SITE_ADDRESS>
# lalu salin tiga baris keluarannya ke sini. Kunci privat adalah rahasia server;
# menggantinya membuat semua langganan push yang ada tidak berlaku.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
