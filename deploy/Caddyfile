# SITE_ADDRESS = nama domain server: Caddy mengambil sertifikat HTTPS (Let's Encrypt)
# sendiri dan mengalihkan HTTP ke HTTPS. ":80" = uji lokal tanpa HTTPS.
{$SITE_ADDRESS} {
	# Aliran notifikasi (SSE) tidak dikompresi supaya tiap notifikasi langsung terkirim;
	# /api/v1/stream adalah aliran yang sama untuk pengembang berkunci API.
	@compress not path /api/stream /api/v1/stream
	encode @compress zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Nama berkas di /assets memuat hash isinya, jadi aman disimpan browser selamanya;
		# halaman (peta dan dokumentasi API) selalu diperiksa ulang supaya versi baru
		# langsung terpakai.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		@page path / /index.html /pengembang.html
		header @page Cache-Control "no-cache"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
