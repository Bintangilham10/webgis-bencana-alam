{
  "name": "sigap-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Pengujian fungsional dan non-fungsional SIGAP Bencana sesuai rencana Tugas 1 (P1–P8, L1–L6)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:chrome": "playwright test --project=chrome",
    "test:browser": "playwright test --grep @lintas-browser",
    "akurasi": "node scripts/akurasi.mjs",
    "kinerja": "node scripts/kinerja.mjs",
    "sus": "node scripts/sus.mjs",
    "gps": "node scripts/galat-gps.mjs",
    "latensi": "node scripts/latensi-notifikasi.mjs",
    "latensi:server": "node scripts/latensi-notifikasi.mjs --api https://sigap-bencana.malaysiawest.cloudapp.azure.com --csv ../research/results/latensi_notifikasi.csv",
    "test:skrip": "node --test \"scripts/*.test.mjs\"",
    "laporan": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "lighthouse": "13.5.0"
  }
}
